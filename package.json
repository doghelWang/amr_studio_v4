{
  "name": "amr-studio",
  "private": true,
  "version": "5.0.0",
  "type": "module",
  "workspaces": ["packages/*", "apps/*"],
  "scripts": {
    "gen": "node scripts/gen-schema.mjs && node scripts/gen-catalog.mjs",
    "test": "vitest run",
    "typecheck": "tsc -b packages/core packages/cli apps/worker && npm -w @amr/web run typecheck",
    "build": "npm run gen && npm -w @amr/web run build",
    "dev": "npm -w @amr/web run dev",
    "amr": "tsx packages/cli/src/main.ts"
  },
  "devDependencies": {
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0",
    "@types/node": "^22.0.0"
  }
}
