      <Group key="sensorAttr" desc="传感属性">
        <Param key="antiLight" type="DATA_BOOL" desc="抗光干扰" value="false"/>
        <Param key="blindZone" type="DATA_DOUBLE" desc="盲区" value="0"/>
        <Param key="needCalib" type="DATA_BOOL" desc="是否需要标定" value="false"/>
      </Group>
      <Group key="scanAttr" desc="扫描属性">
        <Param key="pointAngleMin" type="DATA_DOUBLE" desc="指向角最小值" value="0"/>
        <Param key="pointAngleMax" type="DATA_DOUBLE" desc="指向角最大值" value="0"/>
        <Param key="detecteDistence" type="DATA_DOUBLE" desc="最大测量距离" value="0"/>
        <Param key="accuracy" type="DATA_DOUBLE" desc="测量精度" value="0"/>
