<?xml version="1.0" ?>
<ModuleGroup name="button-Common">
  <Component subsys="InteractiveSys" category="button" type="subButton" vender="HIKROBOT" icon="/ModuleLibrary/PictureRes/0/sphere.png">
    <Identity name="button-Common&#10;" desc="通用按钮"/>
    <Attributes>
      <Group key="buttonAttr" desc="按钮属性">
        <Param key="buttonType" type="DATA_COMBOX" desc="按钮类型" selected="BUTTON_COMP_NOT_EMCY">
          <Option key="BUTTON_COMP_NOT_EMCY" desc="非急停按钮"/>
          <Option key="BUTTON_COMP_EMCY" desc="急停按钮"/>
        </Param>
        <Param key="switchMode" type="DATA_COMBOX" desc="开关方式" selected="knob">
          <Option key="knob" desc="旋钮式"/>
          <Option key="push" desc="按钮式"/>
        </Param>
        <Param key="buttonLamp" type="DATA_COMBOX" desc="按钮灯控制" selected="BUTTON_LAMP_NULL">
          <Option key="BUTTON_LAMP_NULL" desc="无按钮灯"/>
          <Option key="SOFT_BUTTON_LAMP" desc="软件控制按钮灯"/>
          <Option key="HARD_BUTTON_LAMP" desc="硬件控制按钮灯"/>
        </Param>
        <Param key="selfLock" type="DATA_BOOL" desc="是否自锁" value="false"/>
      </Group>
    </Attributes>
    <Interfaces>
      <Ability type="DO" nums="1"/>
      <Instance key="DO_1" type="DO">
        <Param key="isReversed" type="DATA_COMBOX" desc="是否反向"/>
        <Param key="mode" type="DATA_COMBOX" desc="模式"/>
      </Instance>
    </Interfaces>
  </Component>
</ModuleGroup>
