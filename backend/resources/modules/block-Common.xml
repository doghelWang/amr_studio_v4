<?xml version="1.0" ?>
<ModuleGroup name="block-Common">
  <Component subsys="ActorSys" category="actor" type="block" vender="HIKROBOT" icon="/ModuleLibrary/PictureRes/1/cube.png">
    <Identity name="block-Common" desc="通用挡块执行机构"/>
    <Attributes>
      <Group key="blockAttr" desc="挡块属性">
        <Param key="structureForm" type="DATA_COMBOX" desc="结构形式" selected="block">
          <Option key="block" desc="挡块"/>
        </Param>
        <Param key="drivingForm" type="DATA_COMBOX" desc="驱动形式" selected="BDC">
          <Option key="BDC" desc="BDC"/>
        </Param>
        <Param key="transmissionRelationship" type="DATA_COMBOX" desc="传动关系" selected="linear">
          <Option key="linear" desc="线性"/>
        </Param>
        <Param key="totalSpeedRatio" type="DATA_DOUBLE" desc="总速比" value="0"/>
        <Param key="maximumSpeed (Idle)" type="DATA_DOUBLE" desc="最大线速度（空载）" value="0"/>
        <Param key="maximumAcceleration (Idle)" type="DATA_DOUBLE" desc="最大线加速度（空载）" value="0"/>
        <Param key="maximumDeceleration (Idle)" type="DATA_DOUBLE" desc="最大线减速度（空载）" value="0"/>
        <Param key="maximumSpeed (Full Load)" type="DATA_DOUBLE" desc="最大线速度（满载）" value="0"/>
        <Param key="maximumAcceleration  (Full Load)" type="DATA_DOUBLE" desc="最大线加速度（满载）" value="0"/>
        <Param key="maximumDeceleration  (Full Load)" type="DATA_DOUBLE" desc="最大线减速度（满载）" value="0"/>
        <Param key="stroke" type="DATA_DOUBLE" desc="行程" value="0"/>
        <Param key="load" type="DATA_DOUBLE" desc="负载" value="0"/>
      </Group>
    </Attributes>
    <Interfaces/>
  </Component>
</ModuleGroup>
