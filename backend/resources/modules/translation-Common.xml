    <Attributes>
      <Group key="translateAttr" desc="平移属性">
        <Param key="structureForm" type="DATA_COMBOX" desc="结构形式" selected="electircRoll">
          <Option key="electircRoll" desc="电滚筒"/>
          <Option key="selfPowerRoll" desc="自带动力滚筒"/>
          <Option key="externalPowerRoll" desc="外动力滚筒"/>
        </Param>
        <Param key="drivingForm" type="DATA_COMBOX" desc="驱动形式" selected="servo">
          <Option key="servo" desc="伺服"/>
          <Option key="controlCard" desc="控制卡"/>
