        <Param key="maximumAcceleration  (Full Load)" type="DATA_DOUBLE" desc="最大线加速度（满载）" value="0"/>
        <Param key="maximumDeceleration  (Full Load)" type="DATA_DOUBLE" desc="最大线减速度（满载）" value="0"/>
