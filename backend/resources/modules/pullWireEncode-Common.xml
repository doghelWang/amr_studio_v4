<?xml version="1.0" ?>
<ModuleGroup name="pullWireEncode-Common">
  <Component subsys="SensorSys" category="sensor" type="pullWireEncode" vender="HIKROBOT" icon="/ModuleLibrary/PictureRes/1/cube.png">
    <Identity name="pullWireEncode-Common" desc="通用拉线编码器"/>
    <Attributes>
      <Group key="encodeAttr" desc="编码器属性">
        <Param key="wheelCirc" type="DATA_DOUBLE" desc="轮周长" value="0"/>
        <Param key="absEncodeType" type="DATA_COMBOX" desc="编码器类型" selected="SSI_ENCODER">
          <Option key="SSI_ENCODER" desc="SSI编码器"/>
          <Option key="MOTOR_ENCODER" desc="电机编码器"/>
          <Option key="CANOPEN_ENCODER" desc="CANOPEN编码器"/>
          <Option key="CAN_BRT_ENCODER" desc="CAN自定义(BRT)"/>
        </Param>
        <Param key="resolutionMode" type="DATA_COMBOX" desc="分辨率模式" selected="RES_BIT_MODE">
          <Option key="RES_BIT_MODE" desc="位数模式"/>
          <Option key="RES_NUM_MODE" desc="数值模式"/>
        </Param>
        <Param key="isInvert" type="DATA_BOOL" desc="是否反向" value="false"/>
      </Group>
    </Attributes>
    <Interfaces/>
  </Component>
</ModuleGroup>
